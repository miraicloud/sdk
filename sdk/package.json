{
  "name": "@miraicloud/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The mirai.cloud API from TypeScript: Sui data over HTTP, the checkpoint stream and event streams, accounts, API keys and usage, with Sui-signed requests. Built on Effect.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./client": "./src/client.ts",
    "./contract": "./src/contract.ts",
    "./delegation": "./src/delegation.ts",
    "./errors": "./src/errors.ts",
    "./model": "./src/model.ts",
    "./signed": "./src/signed.ts",
    "./signer": "./src/signer.ts",
    "./streams": "./src/streams.ts",
    "./sui": "./src/sui.ts"
  },
  "scripts": {
    "test": "bun test ./test",
    "test:live": "MIRAICLOUD_LIVE=1 bun test ./test/live.test.ts --timeout 900000",
    "typecheck": "tsc -p tsconfig.json",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@miraicloud/core": "*",
    "@protobuf-ts/grpc-transport": "^2.11.1"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.36.0",
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.5",
    "@mysten/sui": "2.36.0",
    "@protobuf-ts/runtime": "2.11.1",
    "@types/bun": "1.4.3",
    "effect": "4.0.5",
    "typescript": "7.0.2"
  }
}
